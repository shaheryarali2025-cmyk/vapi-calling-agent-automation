            {
              "id": "3517d4c0-0db2-4711-baf3-c9860ae1f312",
              "leftValue": "={{   $json.body?.message?.type === 'end-of-call-report'   &&   Boolean(     $json.body?.message?.analysis?.summary     ||     $json.body?.message?.summary   )   &&   Boolean(     $json.body?.message?.artifact?.transcript     ||     $json.body?.message?.transcript   ) }}",
              "rightValue": "",
              "operator": {
