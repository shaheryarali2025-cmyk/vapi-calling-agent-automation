      "id": "ace921b8-2e1a-4a6f-bc8d-d2c96ed9c746",
      "name": "Final Vapi Report Ready"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json;\n\n// Main Vapi payload sections\nconst message = input.body?.message ?? {};\nconst call = message.call ?? {};\nconst analysis = message.analysis ?? {};\nconst artifact = message.artifact ?? {};\n\n// Vapi variables possible locations se read karein\nconst variables =\n  call.assistantOverrides?.variableValues ??\n  artifact.variableValues ??\n  artifact.variables ??\n  message.variableValues ??\n  {};\n\n// Original GHL Contact ID find karein\nconst contactId =\n  message.customer?.externalId ??\n  message.customer?.metadata?.ghl_contact_id ??\n  call.customer?.externalId ??\n  call.customer?.metadata?.ghl_contact_id ??\n  call.metadata?.ghl_contact_id ??\n  variables.ghl_contact_id ??\n  variables.Contact_ID ??\n  variables.contact_id ??\n  \"\";\n\nif (!contactId) {\n  throw new Error(\n    \"Original GHL Contact ID not found in Vapi payload.\"\n  );\n}\n\n// Vapi call ID\nconst callId =\n  call.id ??\n  input.headers?.[\"x-call-id\"] ??\n  String(message.timestamp ?? \"\");\n\nif (!callId) {\n  throw new Error(\n    \"Vapi Call ID was not found in the webhook payload.\"\n  );\n}\n\n// Duplicate protection key\nconst dedupeKey = `vapi-end-of-call-${callId}`;\n\n// Call summary\nconst summary =\n  analysis.summary ??\n  message.summary ??\n  call.analysis?.summary ??\n  \"Call summary was not available.\";\n\n// Call ending information\nconst endedReason =\n  message.endedReason ??\n  call.endedReason ??\n  \"\";\n\nconst callStatus =\n  message.status ??\n  call.status ??\n  \"\";\n\n// Transcript\nconst transcript =\n  artifact.transcript ??\n  message.transcript ??\n  \"\";\n\n// Searchable call text\nconst haystack = [\n  summary,\n  transcript,\n  endedReason,\n  callStatus,\n]\n  .filter(Boolean)\n  .join(\" \");\n\n// Do-not-call detection\nconst doNotCall =\n  /\\b(stop calling|do not call|don't call|wrong number|remove me|unsubscribe)\\b/i\n    .test(haystack);\n\n// Human follow-up detection\nconst humanFollowup =\n  !doNotCall &&\n  /\\b(call me back|human follow[- ]?up|speak to a human|speak with a human|talk to a person|speak to a person|talk to a representative|team member follow up|someone from the team follow up|have someone follow up)\\b/i\n    .test(haystack);\n\n// Unreachable-call detection\nconst unreachable =\n  !doNotCall &&\n  !humanFollowup &&\n  /\\b(no answer|voicemail|busy|failed|unreachable|answering machine)\\b/i\n    .test(haystack);\n\n// Final call outcome\nconst aiCallOutcome = doNotCall\n  ? \"Do Not Call\"\n  : humanFollowup\n    ? \"Human Follow-up\"\n    : unreachable\n      ? \"Unreachable\"\n      : \"Completed\";\n\n// Optional GHL tag\nconst tagName = humanFollowup\n  ? \"ai-human-followup\"\n  : doNotCall\n    ? \"ai-do-not-call\"\n    : unreachable\n      ? \"ai-unreachable\"\n      : \"\";\n\n// GHL note body\nconst noteBody = [\n  `VAPI call: ${callId}`,\n  `Outcome: ${aiCallOutcome}`,\n  `Summary: ${summary}`,\n  `Ended reason: ${endedReason || \"Not provided\"}`,\n].join(\"\\n\");\n\n// Code node is set to \"Run Once for Each Item\",\n// therefore return one object, not an array.\nreturn {\n  json: {\n    ...input,\n\n    ghl_contact_id: contactId,\n    call_id: callId,\n\n    // Used by Remove Duplicates node\n    dedupe_key: dedupeKey,\n\n    call_summary: summary,\n    ended_reason: endedReason,\n    call_status: callStatus,\n\n    ai_call_outcome: aiCallOutcome,\n    human_followup: humanFollowup,\n    do_not_call: doNotCall,\n    unreachable,\n\n    note_body: noteBody,\n    tag_name: tagName,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
